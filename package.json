{
  "name": "beingdb-rewind-interviews",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible BeingDB fact dataset extracted from curated artist interviews (starting with REWIND).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "extract": "tsx src/index.ts",
    "test": "node --import tsx --test 'test/unit/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'test/integration/**/*.test.ts'",
    "validate:beingdb": "node scripts/validate-beingdb.mjs"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
